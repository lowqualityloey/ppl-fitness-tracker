# Copy to .env.local and fill in real values. .env.local is gitignored.
#
# Two connection strings, never interchanged (ADR-0003):
#   DATABASE_URL           — app_authenticated, NOBYPASSRLS, non-owner. What
#                             the running app connects as. Created in M1-04.
#   MIGRATION_DATABASE_URL — the owner role (postgres locally). Migrations
#                             and seeds only. CI-only in a real deployment;
#                             never referenced by runtime request-path code.
#
# Local values (from `npm run db:status` after `npm run db:up`) are the
# well-known Supabase local-dev defaults — public by design, safe to commit
# as placeholders, but the *actual* local values still belong only in
# .env.local, not here, so this file stays a template even locally.

# --- Database ---
DATABASE_URL="postgresql://app_authenticated:REPLACE_ME@127.0.0.1:54329/postgres"
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Supabase client (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_ME"
# Canonical application origin. Never derive auth callback URLs from request Host headers.
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3001"

# --- Server-only. Never imported by client-reachable code (spec §5). ---
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"
