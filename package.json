{
  "name": "ppl-fitness-tracker",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.19.0+sha512-SDd/hHg3KqHE5Ht2NHWxNYNtqCQ2pXAPLl6OtQhPyED5PHsRfrOtO199MZTIG2cQoQ1ZRI9t28shrD+2cr3AAw==",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build && tsx scripts/build-sw-manifest.ts",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --exclude 'tests/integration/api/**'",
    "test:api": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.api.config.ts tests/integration/api/",
    "test:api:preflight": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/preflight.ts",
    "test:red": "npm run test:api",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:mutation": "tsx scripts/mutation-check.ts",
    "perf:sync": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/perf-sync-load.ts",
    "perf:contention": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/perf-sync-contention.ts",
    "db:up": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector",
    "db:down": "supabase stop",
    "db:status": "supabase status -o env",
    "db:seed": "tsx db/seed/exercises.ts",
    "db:seed:stretches": "tsx db/seed/stretches.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@sentry/nextjs": "10.74.0",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.44.0",
    "next": "16.4.1",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "lighthouse": "^13.4.1",
    "supabase": "2.117.0",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
