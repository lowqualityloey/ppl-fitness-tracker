{
  "name": "ppl-fitness-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "next:dev": "next dev --port 3001",
    "next:build": "next build",
    "next:start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --exclude 'tests/integration/api/**'",
    "test:api": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/integration/api/",
    "test:api:preflight": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/preflight.ts",
    "test:red": "npm run test:api",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:mutation": "tsx scripts/mutation-check.ts",
    "db:up": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector",
    "db:down": "supabase stop",
    "db:status": "supabase status -o env",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx db/seed/exercises.ts",
    "db:seed:stretches": "tsx db/seed/stretches.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.116.0",
    "drizzle-orm": "^0.36.4",
    "pg": "8.23.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "supabase": "2.117.0",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vite": "^7.1.7",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
